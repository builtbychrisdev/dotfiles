{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "color": { "1": "yellow", "2": "yellow" },
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "yellow", "title": "yellow" },
    "key": { "width": 11 }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "custom", "format": "\u001b[90m────────────────────────────" },
    { "type": "os", "key": "os" },
    { "type": "kernel", "key": "kernel", "format": "{release}" },
    { "type": "uptime", "key": "uptime" },
    { "type": "packages", "key": "pkgs" },
    { "type": "shell", "key": "shell" },
    { "type": "wm", "key": "wm" },
    { "type": "terminal", "key": "term" },
    { "type": "display", "key": "display" },
    { "type": "custom", "format": "\u001b[90m────────────────────────────" },
    { "type": "cpu", "key": "cpu", "format": "{name} ({cores-logical}) @ {freq-max}" },
    { "type": "gpu", "key": "gpu", "format": "{name}" },
    { "type": "memory", "key": "memory" },
    { "type": "disk", "key": "disk" },
    { "type": "localip", "key": "lan" },
    { "type": "custom", "format": "\u001b[90m────────────────────────────" },
    { "type": "colors", "symbol": "circle" },
    "break"
  ]
}
